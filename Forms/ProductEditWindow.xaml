<Window x:Class="Namordnik.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование продукта"
        Height="750" Width="700"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <ScrollViewer>
        <StackPanel Margin="15">

            <!-- основные сведения -->
            <TextBlock Text="Основные сведения" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Артикул" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
                <TextBox x:Name="txtArticle" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Наименование *" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
                <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Тип продукта" Grid.Row="2" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
                <ComboBox x:Name="cbType" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Минимальная цена *" Grid.Row="3" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center" ToolTip="Формат: 99.99"/>
                <TextBox x:Name="txtPrice" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" Padding="5"/>
            </Grid>

            <!-- производство -->
            <TextBlock Text="Производство" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Количество людей" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Center"/>
                <TextBox x:Name="txtPeople" Grid.Row="0" Grid.Column="1" Margin="0,0,10,10" Padding="5"/>

                <TextBlock Text="Номер цеха" Grid.Row="0" Grid.Column="2" Margin="0,0,10,10" VerticalAlignment="Center"/>
                <TextBox x:Name="txtWorkshop" Grid.Row="0" Grid.Column="3" Margin="0,0,0,10" Padding="5"/>

                <TextBlock Text="Описание" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalAlignment="Top"/>
                <TextBox x:Name="txtDescription" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" 
                         Height="80" Margin="0,0,0,10" Padding="5" 
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- изображение -->
            <TextBlock Text="Изображение" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>

            <Border Height="150" Background="#F5F5F5" CornerRadius="3" Margin="0,0,0,10">
                <Image x:Name="imgProduct" Stretch="Uniform"/>
            </Border>
            <Button x:Name="btnSelectImage" Content="Выбрать изображение" Click="BtnImage_Click" Padding="10,8" Margin="0,0,0,20" Width="200" HorizontalAlignment="Left"/>

            <!-- материалы -->
            <TextBlock Text="Материалы для производства" FontSize="14" FontWeight="Bold" Margin="0,10,0,10"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <ComboBox x:Name="cbMaterials" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" Padding="5" IsEditable="True"/>
                <TextBox x:Name="txtMatCount" Grid.Row="0" Grid.Column="1" Margin="0,0,10,10" Padding="5" ToolTip="Количество"/>
                <Button x:Name="btnAddMaterial" Content="Добавить" Grid.Row="0" Grid.Column="2" Click="AddMaterial_Click" Padding="10,5" Margin="0,0,10,10"/>
                <Button x:Name="btnRemoveMaterial" Content="Удалить" Grid.Row="0" Grid.Column="3" Click="RemoveMaterial_Click" Padding="10,5" Margin="0,0,0,10"/>

                <ListBox x:Name="lbMaterials" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"/>
            </Grid>

            <!-- кнопки действий -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="btnSave" Content="Сохранить" Click="Save_Click" Padding="15,10" Margin="5"/>
                <Button x:Name="btnDelete" Content="Удалить" Click="Delete_Click" Padding="15,10" Margin="5"/>
                <Button x:Name="btnCancel" Content="Отмена" Click="Button_Click" Padding="15,10" Margin="5"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>