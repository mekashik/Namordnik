<Window x:Class="Namordnik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Namordnik"
        mc:Ignorable="d"
                    Title="Продукция" Height="800" Width="1400"
    Loaded="Window_Loaded" Icon="/Forms/Намордник.png">

    <Window.Resources>


        <Style x:Key="ProductCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="10"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#FFFFCCCC"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="467*"/>
            <ColumnDefinition Width="83*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <!-- Панель управления -->
        <Border Grid.Row="0" Background="#F0F0F0" Padding="10" Margin="0,0,0,5" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="txtSearch" Width="300" Height="30" 
                     TextChanged="TxtSearch_TextChanged" 
                     ToolTip="Поиск по названию и описанию"
                     Margin="0,0,10,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <ComboBox x:Name="cbSort" SelectedIndex="0" 
                      SelectionChanged="CbSort_SelectionChanged" 
                      Width="200" Height="30" Margin="0,0,10,0"
                      ToolTip="Сортировка">
                    <ComboBoxItem Content="Сортировка"/>
                    <ComboBoxItem Content="По имени (А-Я)" Tag="NameAsc"/>
                    <ComboBoxItem Content="По имени (Я-А)" Tag="NameDesc"/>
                    <ComboBoxItem Content="По цеху (возр)" Tag="WorkshopAsc"/>
                    <ComboBoxItem Content="По цеху (убыв)" Tag="WorkshopDesc"/>
                    <ComboBoxItem Content="По цене (возр)" Tag="PriceAsc"/>
                    <ComboBoxItem Content="По цене (убыв)" Tag="PriceDesc"/>
                </ComboBox>

                <ComboBox x:Name="cbFilter" SelectedIndex="0" 
                      SelectionChanged="CbFilter_SelectionChanged" 
                      Width="180" Height="30" Margin="10,0,0,0"
                      ToolTip="Фильтр по типу">
                    <ComboBoxItem Content="Все типы" Tag="ALL"/>
                </ComboBox>

                <TextBlock x:Name="tbSelectedCount" 
                       FontWeight="Bold" Foreground="#0078D7" FontSize="14"/>
            </StackPanel>
        </Border>

        <!-- Список продуктов -->
        <ScrollViewer Grid.Row="1"
              Margin="10"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              Grid.ColumnSpan="2">
            <ItemsControl x:Name="itemsControlProducts" 
              ItemsSource="{Binding Products}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProductCardStyle}" Background="LightGray" MouseDown="Product_Click">
                            <Grid Height="165">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>

                                <!-- Изображение -->
                                <Border Grid.Column="0" Background="#F5F5F5" 
                                    CornerRadius="3" Margin="0">
                                    <Grid>
                                        <Image Source="{Binding ProductImage}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           Height="160" Width="160"
                                           Stretch="Uniform">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Grid>
                                </Border>

                                <!-- Информация о продукте -->
                                <StackPanel Grid.Column="1" Margin="15,5,5,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Type}" 
                                               FontSize="18" 
                                               FontWeight="Bold"/>
                                        <TextBlock Text=" | " 
                                               FontSize="18" 
                                               Margin="10,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" 
                                               FontSize="18" 
                                               FontWeight="Bold" Width="800"
                                                />
                                    </StackPanel>

                                    <TextBlock Text="{Binding Article}" 
                                           FontSize="14" 
                                           Margin="0,5,0,0" 
                                           Foreground="#666666"/>
                                    <Separator Margin="0,28,0,10" 
                                               Background="Gray"/>

                                    <TextBlock FontSize="14" Margin="0,3,0,0">
                                    <Run Text="Цех №"/>
                                    <Run Text="{Binding WorkshopNumber}" 
                                    FontWeight="Bold"/>
                                    <Run Text=" | Персонал: "/>
                                    <Run Text="{Binding PeopleCount}" 
                                    FontWeight="Bold"/>
                                    </TextBlock>


                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Материалы: " 
                                               FontSize="14" 
                                               FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Materials}" 
                                               FontSize="14" 
                                               TextWrapping="Wrap" 
                                               Width="500"
                                               Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Description}" 
                                           FontSize="13" 
                                           Margin="0,10,0,0" 
                                           TextWrapping="Wrap" 
                                           Foreground="#666666" 
                                           Width="600"/>
                                </StackPanel>

                                <!-- Стоимости -->
                                <StackPanel Grid.Column="2" 
                                        HorizontalAlignment="Right" 
                                        Margin="0,10,10,0">
                                    <TextBlock Text="Стоимость" 
                                           FontSize="16" 
                                           HorizontalAlignment="Right"
                                           Foreground="Black"/>
                                    <TextBlock Text="{Binding AgentPrice, StringFormat='{}{0:N2} ₽'}" 
                                           FontSize="22" 
                                           FontWeight="Bold" 
                                           HorizontalAlignment="Right" 
                                           Margin="0,5,0,0"/>

                                    <Separator Margin="0,15,0,10" 
                                           Background="Gray"/>
                                    <TextBlock Text="Стоимость материалов" 
                                      FontSize="13" 
                                      HorizontalAlignment="Right"
                                      Foreground="#666666"/>
                                    <TextBlock Text="{Binding MaterialCost, StringFormat='{}{0:N2} ₽'}" 
                                      FontSize="16" 
                                      FontWeight="SemiBold" 
                                      HorizontalAlignment="Right" 
                                      Margin="0,5,0,0"/>

                                    <TextBlock Text="{Binding HighlightReason}" 
                                       FontSize="11" 
                                       HorizontalAlignment="Right"
                                       Foreground="Black" 
                                       Margin="0,10,0,0"
                                       FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>

                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
          HorizontalAlignment="Right"
          VerticalAlignment="Top"
          Margin="0,5,5,0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Панель -->
        <Border Grid.Row="2" Background="#F0F0F0" Padding="10" Grid.ColumnSpan="2">
            <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center">

                <Button Content="Добавить продукцию"
        Click="BtnAddProduct_Click"
        Margin="10"
        Padding="10,5" Height="30"/>

                <Button x:Name="btnChangePrice"
        Content="Изменить стоимость"
        Click="BtnChangePrice_Click"
        Margin="10,0,20,0"
        Padding="10,5" Height="30"/>

                <Button x:Name="btnPrev" Content="◄" FontSize="20"
                    Click="BtnPrev_Click" 
                    Width="30" Height="30" Margin="2"
                    ToolTip="Предыдущая страница"/>

                <StackPanel x:Name="spPageNumbers" 
                        Orientation="Horizontal" 
                        Margin="5"/>

                <Button x:Name="btnNext" Content="►" FontSize="20"
                    Click="BtnNext_Click" 
                    Width="30" Height="30" Margin="2"
                    ToolTip="Следующая страница"/>

                <TextBlock x:Name="tbPageInfo" 
                       VerticalAlignment="Center" 
                       Margin="10,0,0,0"
                       FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
