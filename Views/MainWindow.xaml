<Window x:Class="Namordnik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Namordnik"
        mc:Ignorable="d"
        Title="Продукция"
        Height="900"
        Width="1500"
        Loaded="Window_Loaded"
        Icon="/Views/Намордник.png"
        Background="#FFFFFF"
        FontFamily="Tw Cen MT">

    <Window.Resources>

        <!-- Цвета -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#B0E5FD"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FDBD40"/>
        <SolidColorBrush x:Key="DarkBrush" Color="#2B2B2B"/>

        <!-- Карточки -->
        <Style x:Key="ProductCardStyle" TargetType="Border">

            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BorderBrush" Value="#ECECEC"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="4"
                                      Opacity="0.12"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FDBD40"/>
                </Trigger>

                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Background" Value="#FFD6D6"/>
                    <Setter Property="BorderBrush" Value="#FDBD40"/>
                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">

                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">

                            <ScrollViewer x:Name="PART_ContentHost"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FDBD40"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1.5"/>

        </Style>

        <!-- Кнопки -->
        <Style TargetType="Button">

            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2B2B2B"/>
            <Setter Property="Background" Value="#FDBD40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <Grid Background="#F8FCFF">

        <Grid.RowDefinitions>
            <RowDefinition Height="95"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="90"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#B0E5FD">

            <Grid Margin="25,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="58"
                        Height="58"
                        Background="White"
                        CornerRadius="15"
                        VerticalAlignment="Center">

                    <Image Source="/Views/Намордник.png"
                           Stretch="Uniform"
                           Margin="8"/>

                </Border>

                <StackPanel Grid.Column="1"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">

                    <TextBlock Text="Каталог продукции"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#2B2B2B"/>

                    <TextBlock Text="Управление ассортиментом и производством"
                               FontSize="16"
                               Foreground="#4F4F4F"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- ПАНЕЛЬ ФИЛЬТРОВ -->
        <Border Grid.Row="1"
                Margin="20,20,20,10"
                Padding="20"
                Background="White"
                CornerRadius="20"
                BorderBrush="#EAEAEA"
                BorderThickness="1">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <!-- Поиск -->
                <TextBox x:Name="txtSearch"
                         Width="350"
                         TextChanged="TxtSearch_TextChanged"
                         ToolTip="Поиск по названию и описанию"/>

                <!-- Сортировка -->
                <ComboBox x:Name="cbSort"
                          Width="230"
                          Margin="15,0,0,0"
                          SelectedIndex="0"
                          SelectionChanged="CbSort_SelectionChanged">

                    <ComboBoxItem Content="Сортировка"/>
                    <ComboBoxItem Content="По имени (А-Я)" Tag="NameAsc"/>
                    <ComboBoxItem Content="По имени (Я-А)" Tag="NameDesc"/>
                    <ComboBoxItem Content="По цеху (возр)" Tag="WorkshopAsc"/>
                    <ComboBoxItem Content="По цеху (убыв)" Tag="WorkshopDesc"/>
                    <ComboBoxItem Content="По цене (возр)" Tag="PriceAsc"/>
                    <ComboBoxItem Content="По цене (убыв)" Tag="PriceDesc"/>

                </ComboBox>

                <!-- Фильтр -->
                <ComboBox x:Name="cbFilter"
                          Width="200"
                          Margin="15,0,0,0"
                          SelectedIndex="0"
                          SelectionChanged="CbFilter_SelectionChanged">

                    <ComboBoxItem Content="Все типы" Tag="ALL"/>

                </ComboBox>

                <!-- Счётчик -->
                <Border Background="#FDBD40"
                        CornerRadius="12"
                        Padding="14,8"
                        Margin="20,0,0,0">

                    <TextBlock x:Name="tbSelectedCount"
                               FontSize="15"
                               FontWeight="Bold"
                               Foreground="#2B2B2B"/>

                </Border>

            </StackPanel>

        </Border>

        <!-- КАТАЛОГ -->
        <ScrollViewer Grid.Row="2"
                      Margin="20,0,20,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <ItemsControl x:Name="itemsControlProducts"
                          ItemsSource="{Binding Products}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border Style="{StaticResource ProductCardStyle}"
                                MouseDown="Product_Click">

                            <Grid Height="220">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="240"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <!-- ИЗОБРАЖЕНИЕ -->
                                <Border Grid.Column="0"
                                        Background="#F7FBFD"
                                        CornerRadius="18">

                                    <Image Source="{Binding ProductImage}"
                                           Stretch="Uniform"
                                           Margin="12"/>

                                </Border>

                                <!-- ИНФОРМАЦИЯ -->
                                <StackPanel Grid.Column="1"
                                            Margin="25,0">

                                    <!-- Название -->
                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="{Binding Type}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="#2B2B2B"/>

                                        <TextBlock Text=" • "
                                                   FontSize="22"
                                                   Margin="8,0"/>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Width="700"
                                                   TextWrapping="Wrap"/>

                                    </StackPanel>

                                    <!-- Артикул -->
                                    <TextBlock Text="{Binding Article}"
                                               FontSize="15"
                                               Margin="0,8,0,0"
                                               Foreground="#7A7A7A"/>

                                    <Separator Margin="0,18,0,15"/>

                                    <!-- Производство -->
                                    <TextBlock FontSize="15">

                                        <Run Text="Цех № "/>

                                        <Run Text="{Binding WorkshopNumber}"
                                             FontWeight="Bold"/>

                                        <Run Text="   |   Сотрудников: "/>

                                        <Run Text="{Binding PeopleCount}"
                                             FontWeight="Bold"/>

                                    </TextBlock>

                                    <!-- Материалы -->
                                    <Border Background="#F7FBFD"
                                            CornerRadius="10"
                                            Padding="10"
                                            Margin="0,15,0,0">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock Text="Материалы:"
                                                       FontWeight="Bold"
                                                       FontSize="14"/>

                                            <TextBlock Text="{Binding Materials}"
                                                       FontSize="14"
                                                       Margin="8,0,0,0"
                                                       Width="500"
                                                       TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </Border>

                                    <!-- Описание -->
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="14"
                                               Margin="0,15,0,0"
                                               Foreground="#666666"
                                               Width="650"
                                               TextWrapping="Wrap"/>

                                </StackPanel>

                                <!-- ПРАВАЯ ПАНЕЛЬ -->
                                <StackPanel Grid.Column="2"
                                            HorizontalAlignment="Right">

                                    <Border Background="#FDBD40"
                                            CornerRadius="14"
                                            Padding="18,10">

                                        <StackPanel>

                                            <TextBlock Text="Стоимость"
                                                       FontSize="15"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="{Binding AgentPrice, StringFormat='{}{0:N2} ₽'}"
                                                       FontSize="28"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"/>

                                        </StackPanel>

                                    </Border>

                                    <Border Background="#F7FBFD"
                                            CornerRadius="14"
                                            Padding="15"
                                            Margin="0,15,0,0">

                                        <StackPanel>

                                            <TextBlock Text="Стоимость материалов"
                                                       FontSize="13"
                                                       Foreground="#666666"
                                                       HorizontalAlignment="Center"/>

                                            <TextBlock Text="{Binding MaterialCost, StringFormat='{}{0:N2} ₽'}"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,5,0,0"/>

                                        </StackPanel>

                                    </Border>

                                    <!-- Выделение -->
                                    <TextBlock Text="{Binding HighlightReason}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="#D17C00"
                                               Margin="0,15,0,0"
                                               HorizontalAlignment="Right">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>

                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              HorizontalAlignment="Right"
                                              Margin="0,20,0,0"/>

                                </StackPanel>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#EAEAEA"
                BorderThickness="1,1,0,0"
                Padding="20">

            <DockPanel>

                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Left">

                    <Button Content="Добавить продукцию"
                            Width="220"
                            Height="46"
                            Margin="0,0,15,0"
                            Click="BtnAddProduct_Click"/>

                    <Button x:Name="btnChangePrice"
                            Content="Изменить стоимость "
                            Width="220"
                            Height="46"
                            Background="#2B2B2B"
                            Foreground="White"
                            Click="BtnChangePrice_Click"/>

                </StackPanel>

                <!-- Пагинация -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button x:Name="btnPrev"
                            Content="◀"
                            Width="42"
                            Height="42"
                            FontSize="18"
                            Click="BtnPrev_Click"/>

                    <StackPanel x:Name="spPageNumbers"
                                Orientation="Horizontal"
                                Margin="8,0"/>

                    <Button x:Name="btnNext"
                            Content="▶"
                            Width="42"
                            Height="42"
                            FontSize="18"
                            Click="BtnNext_Click"/>

                    <TextBlock x:Name="tbPageInfo"
                               VerticalAlignment="Center"
                               Margin="15,0,0,0"
                               FontSize="15"
                               FontWeight="SemiBold"/>

                </StackPanel>

            </DockPanel>

        </Border>

    </Grid>

</Window>