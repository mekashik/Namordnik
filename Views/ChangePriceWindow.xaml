<Window x:Class="Namordnik.ChangePriceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменение стоимости"
        Height="420"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF"
        FontFamily="Tw Cen MT"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow" Icon="/Views/Намордник.png">

    <Window.Resources>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#FAFAFA"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1.5"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FDBD40"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#2B2B2B"/>
            <Setter Property="Background" Value="#FDBD40"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="#F8FCFF">

        <!-- Шапка -->
        <Border Background="#B0E5FD"
            Height="100"
            VerticalAlignment="Top">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Логотип -->
                <Border Width="58"
                    Height="58"
                    Background="White"
                    CornerRadius="15"
                    VerticalAlignment="Center">

                    <Image Source="/Views/Намордник.png"
                       Stretch="Uniform"
                       Margin="8"/>
                </Border>

                <!-- Текст -->
                <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Margin="18,0,0,0">

                    <TextBlock Text="Изменение стоимости"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#2B2B2B"/>

                    <TextBlock Text="Введите сумму увеличения цены"
                           FontSize="15"
                           Foreground="#555555"
                           Margin="0,4,0,0"/>

                </StackPanel>

            </Grid>

        </Border>

        <!-- Контент -->
        <Border Margin="25,125,25,25"
            Background="White"
            CornerRadius="20"
            Padding="25">

            <StackPanel>

                <TextBlock Text="Сумма изменения"
                       FontSize="16"
                       Margin="0,0,0,10"/>

                <TextBox x:Name="txtValue"/>

                <TextBlock x:Name="tbAverage"
                       Margin="0,12,0,0"
                       FontSize="14"
                       Foreground="#666666"/>

                <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,30,0,0">

                    <Button Content="Отмена"
                        Width="140"
                        Height="45"
                        Background="#D9D9D9"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                    <Button Content="Изменить"
                        Width="160"
                        Height="45"
                        Click="Save_Click"/>

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>
</Window>