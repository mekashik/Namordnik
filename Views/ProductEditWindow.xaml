<Window x:Class="Namordnik.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование продукции"
        Height="820"
        Width="760"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#FFFFFF"
        FontFamily="Tw Cen MT"
        Icon="/Views/Намордник.png">

    <Window.Resources>

        <!-- Цвета -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryBrush" Color="#B0E5FD"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FDBD40"/>
        <SolidColorBrush x:Key="DarkBrush" Color="#2B2B2B"/>

        <!-- Карточка -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="BorderBrush" Value="#E7E7E7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20"
                                      ShadowDepth="3"
                                      Opacity="0.15"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовки -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2B2B2B"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="BorderBrush" Value="#D8D8D8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#FDBD40"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,5,0,12"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#F9F9F9"/>
            <Setter Property="BorderBrush" Value="#D8D8D8"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- Кнопки -->
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#2B2B2B"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#FDBD40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Background="#B0E5FD"
                Grid.Row="0">

            <Grid Margin="25,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="55"
                        Height="55"
                        Background="White"
                        CornerRadius="14"
                        VerticalAlignment="Center">

                    <Image Source="/Views/Намордник.png"
                           Stretch="Uniform"
                           Margin="8"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="20,0,0,0">

                    <TextBlock Text="Редактирование продукции"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#2B2B2B"/>

                    <TextBlock Text="Управление информацией о товаре"
                               FontSize="16"
                               Foreground="#555555"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- CONTENT -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="25">

                <!-- Основная информация -->
                <Border Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Основные сведения"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Артикул"
                                       Grid.Row="0"
                                       VerticalAlignment="Center"
                                       FontSize="16"/>

                            <TextBox x:Name="txtArticle"
                                     Grid.Row="0"
                                     Grid.Column="1"/>

                            <TextBlock Text="Наименование *"
                                       Grid.Row="1"
                                       VerticalAlignment="Center"
                                       FontSize="16"/>

                            <TextBox x:Name="txtName"
                                     Grid.Row="1"
                                     Grid.Column="1"/>

                            <TextBlock Text="Тип продукции"
                                       Grid.Row="2"
                                       VerticalAlignment="Center"
                                       FontSize="16"/>

                            <ComboBox x:Name="cbType"
                                      Grid.Row="2"
                                      Grid.Column="1"/>

                            <TextBlock Text="Минимальная цена *"
                                       Grid.Row="3"
                                       VerticalAlignment="Center"
                                       FontSize="16"/>

                            <TextBox x:Name="txtPrice"
                                     Grid.Row="3"
                                     Grid.Column="1"/>
                        </Grid>

                    </StackPanel>

                </Border>

                <!-- Производство -->
                <Border Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Производство"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Количество сотрудников"
                                       Grid.Row="0"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>

                            <TextBox x:Name="txtPeople"
                                     Grid.Row="0"
                                     Grid.Column="1"/>

                            <TextBlock Text="Номер цеха"
                                       Grid.Row="0"
                                       Grid.Column="2"
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="20,0,0,0"/>

                            <TextBox x:Name="txtWorkshop"
                                     Grid.Row="0"
                                     Grid.Column="3"/>

                            <TextBlock Text="Описание"
                                       Grid.Row="1"
                                       FontSize="16"
                                       VerticalAlignment="Top"/>

                            <TextBox x:Name="txtDescription"
                                     Grid.Row="1"
                                     Grid.Column="1"
                                     Grid.ColumnSpan="3"
                                     Height="120"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>
                        </Grid>

                    </StackPanel>

                </Border>

                <!-- Изображение -->
                <Border Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Изображение продукции"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Border Height="220"
                                CornerRadius="16"
                                Background="#F7FBFD"
                                BorderBrush="#DDEFF8"
                                BorderThickness="2">

                            <Image x:Name="imgProduct"
                                   Stretch="Uniform"
                                   Margin="10"/>
                        </Border>

                        <Button x:Name="btnSelectImage"
                                Content="Выбрать изображение"
                                Width="240"
                                HorizontalAlignment="Left"
                                Margin="0,20,0,0"
                                Click="BtnImage_Click"/>

                    </StackPanel>

                </Border>

                <!-- Материалы -->
                <Border Style="{StaticResource CardStyle}">

                    <StackPanel>

                        <TextBlock Text="Материалы для производства"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="cbMaterials"
                                      Grid.Column="0"
                                      IsEditable="True"/>

                            <TextBox x:Name="txtMatCount"
                                     Grid.Column="1"
                                     Margin="10,5"/>

                            <Button x:Name="btnAddMaterial"
                                    Grid.Column="2"
                                    Content="Добавить"
                                    Click="AddMaterial_Click"/>

                            <Button x:Name="btnRemoveMaterial"
                                    Grid.Column="3"
                                    Background="#FF7A7A"
                                    Foreground="White"
                                    Content="Удалить"
                                    Click="RemoveMaterial_Click"/>

                        </Grid>

                        <Border Margin="0,20,0,0"
                                CornerRadius="14"
                                Background="#F9F9F9"
                                Padding="10">

                            <ListBox x:Name="lbMaterials"
                                     BorderThickness="0"
                                     Background="Transparent"/>
                        </Border>

                    </StackPanel>

                </Border>

                <!-- Кнопки -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,10,0,20">

                    <Button x:Name="btnSave"
                            Width="170"
                            Height="48"
                            FontWeight="Bold"
                            Content="Сохранить"
                            Click="Save_Click"/>

                    <Button x:Name="btnDelete"
                            Width="170"
                            Height="48"
                            Background="#FF8A8A"
                            Foreground="White"
                            Content="Удалить"
                            Click="Delete_Click"/>

                    <Button x:Name="btnCancel"
                            Width="170"
                            Height="48"
                            Background="#D9D9D9"
                            Content="Отмена"
                            Click="Button_Click"/>

                </StackPanel>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</Window>